# agent-csharp: C# agent image. Adds .NET SDK on top of agent-base.
#
# Build context must be the repository root:
#   podman build -t agent-csharp -f images/agent-csharp/Containerfile .

ARG BASE_IMAGE=quay.io/konveyor/agent-base:latest
FROM ${BASE_IMAGE} AS base

USER root

RUN dnf install -y \
    dotnet-sdk-8.0 \
    && dnf clean all

USER 1001

ENTRYPOINT ["migration-harness"]
CMD ["run"]
